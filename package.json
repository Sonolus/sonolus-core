{
  "name": "@sonolus/core",
  "version": "7.16.0",
  "description": "Core library for Sonolus",
  "author": "NonSpicyBurrito",
  "repository": "github:Sonolus/sonolus-core",
  "license": "MIT",
  "keywords": [
    "Sonolus"
  ],
  "type": "module",
  "exports": {
    ".": {
      "node": "./dist/index.node.js",
      "default": "./dist/index.default.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check-type": "tsc -p . --noEmit",
    "check-lint": "oxlint",
    "check-format": "oxfmt --check",
    "build": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  }
}
